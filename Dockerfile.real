# CRANE-X7 実機ドライバ用（crane_x7_control のみ）。Linux ホストで USB を渡して使う。
# シミュ用の Dockerfile.arm と違い Gazebo / MoveIt / VNC は入れない。
# ベースは digest で固定する（multi-arch の manifest list）。更新するときは digest を差し替える。
FROM ros:jazzy-ros-base@sha256:c3706ef0a0aa45413c07803cf433602f543b22e45b4855f6fca955c2d8ecc4e8

SHELL ["/bin/bash", "-c"]

# crane_x7_ros / crane_x7_description は apt 未提供のためソースビルド。
# 再現性のため Dockerfile.arm と同じコミットに固定する。
# crane_x7_description は非商用ライセンス（README 参照）。
ARG CRANE_X7_ROS_REF=3761ab179dbcbd7432b28968340e2225978006de
ARG CRANE_X7_DESCRIPTION_REF=61865950f741f0d5a35e28eb0a7d2501cac86e7b
RUN mkdir -p /opt/crane_ws/src && cd /opt/crane_ws/src \
    && apt-get update \
    && apt-get install -y --no-install-recommends git \
    && git clone https://github.com/rt-net/crane_x7_ros.git \
    && git -C crane_x7_ros checkout "$CRANE_X7_ROS_REF" \
    && git clone https://github.com/rt-net/crane_x7_description.git \
    && git -C crane_x7_description checkout "$CRANE_X7_DESCRIPTION_REF" \
    && source /opt/ros/jazzy/setup.bash \
    && rosdep update --rosdistro jazzy \
    && rosdep install -y -i --rosdistro jazzy \
        --from-paths crane_x7_ros/crane_x7_control crane_x7_description \
    && cd /opt/crane_ws \
    && colcon build --packages-up-to crane_x7_control \
    && apt-get clean \
    && rm -rf /opt/crane_ws/build /opt/crane_ws/log /var/lib/apt/lists/*

# 隔離設定は ros2lab と同じ。ros2-lab-net 上の ros2lab とだけ Discovery する
ENV ROS_DOMAIN_ID=42
ENV ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# login / 対話どちらのシェルでも source されるよう profile.d に置く（Dockerfile と同じ流儀）
RUN printf '%s\n' \
    '# --- ros2-poc: real arm driver env ---' \
    'source /opt/ros/jazzy/setup.bash' \
    'source /opt/crane_ws/install/setup.bash' \
    'echo "[ros2real] DOMAIN=$ROS_DOMAIN_ID discovery=$ROS_AUTOMATIC_DISCOVERY_RANGE"' \
    > /etc/profile.d/ros2real.sh \
    && echo '[ -f /etc/profile.d/ros2real.sh ] && source /etc/profile.d/ros2real.sh' >> /root/.bashrc

WORKDIR /workspace

# ドライバは手動起動（トルクオンを人が制御する）。手順は README「実機で動かす」参照。
CMD ["sleep", "infinity"]
