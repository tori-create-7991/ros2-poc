# ROS 2 アームシミュ用: ブラウザ(noVNC) またはネイティブ VNC クライアントから Gazebo / MoveIt 2 / RViz2 を操作する。
# 週次で更新されるため日付タグ + digest（multi-arch の manifest list）で固定する。
# 動作確認は arm64（Colima）のみ。amd64 はベースイメージが対応している。
FROM tiryoh/ros2-desktop-vnc:jazzy-20260927T0957@sha256:3d0bcd5a6ec951cde22f50c79d96fe93f1f3001a6425369d0cd833ad37b766f8

SHELL ["/bin/bash", "-c"]

# Gazebo Harmonic (ros-gz) はベースイメージに同梱。MoveIt 2 と UR / Panda デモを追加する
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ros-jazzy-moveit \
        ros-jazzy-moveit-resources-panda-moveit-config \
        ros-jazzy-ur-simulation-gz \
        ros-jazzy-ur-moveit-config \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# CRANE-X7 (アールティ): apt 未提供のためソースビルド。再現性のためコミット固定。
# crane_x7_description は非商用ライセンス（README 参照）。
ARG CRANE_X7_ROS_REF=3761ab179dbcbd7432b28968340e2225978006de
ARG CRANE_X7_DESCRIPTION_REF=61865950f741f0d5a35e28eb0a7d2501cac86e7b
RUN mkdir -p /opt/crane_ws/src && cd /opt/crane_ws/src \
    && git clone https://github.com/rt-net/crane_x7_ros.git \
    && git -C crane_x7_ros checkout "$CRANE_X7_ROS_REF" \
    && git clone https://github.com/rt-net/crane_x7_description.git \
    && git -C crane_x7_description checkout "$CRANE_X7_DESCRIPTION_REF" \
    && apt-get update \
    && source /opt/ros/jazzy/setup.bash \
    && rosdep update --rosdistro jazzy \
    && rosdep install -y -i --from-paths /opt/crane_ws/src --rosdistro jazzy \
    && cd /opt/crane_ws && colcon build \
    && rm -rf /opt/crane_ws/build /opt/crane_ws/log /var/lib/apt/lists/*

# ネイティブ VNC クライアント用ブリッジ。ベースイメージの Xtigervnc は -localhost=1 で
# コンテナ内ループバック(127.0.0.1:5901)にしか待ち受けないため、Docker の公開ポートが届かない。
# socat で 0.0.0.0:5900 -> 127.0.0.1:5901 に中継する（実測: Xtigervnc は 5901）。
# ベースの entrypoint は conf.d/supervisord.conf だけを書き直すので、別ファイルで追加すれば残る。
# 認証は Xtigervnc の VncAuth のまま。ホストへは docker-compose.yml で 127.0.0.1 限定で公開する。
RUN printf '%s\n' \
    '[program:vncbridge]' \
    'command=socat TCP-LISTEN:5900,fork,reuseaddr TCP:127.0.0.1:5901' \
    'autorestart=true' \
    > /etc/supervisor/conf.d/vncbridge.conf

# 隔離設定は ros2lab と同じ。ros2-lab-net 上の ros2lab とだけ Discovery する
ENV ROS_DOMAIN_ID=42
ENV ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# デスクトップの端末がコンテナ ENV を継承しない場合に備え、ubuntu ユーザーの .bashrc にも書く
RUN printf '%s\n' \
    '# --- ros2-poc: arm sim env ---' \
    'export ROS_DOMAIN_ID=42' \
    'export ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET' \
    'source /opt/ros/jazzy/setup.bash' \
    'source /opt/crane_ws/install/setup.bash' \
    >> /home/ubuntu/.bashrc

# カメラプロファイル層（ros2_poc_sim）: Gazebo の仮想カメラを実カメラ（usb_cam / RealSense D435）と
# 同じトピック名・型・フレームで出す。/opt/crane_ws の上に overlay ワークスペースとして重ねる
# （公式コミットは書き換えない）。使い方は docs/sim-camera-profile.md。
COPY ros2_poc_sim /opt/ros2_poc_ws/src/ros2_poc_sim
RUN source /opt/ros/jazzy/setup.bash \
    && source /opt/crane_ws/install/setup.bash \
    && cd /opt/ros2_poc_ws && colcon build \
    && rm -rf /opt/ros2_poc_ws/build /opt/ros2_poc_ws/log \
    && printf '%s\n' 'source /opt/ros2_poc_ws/install/setup.bash' >> /home/ubuntu/.bashrc
