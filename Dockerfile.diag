# 診断コンテナ（ros2diag）: ros2lab と同じ ROS 環境に、パケット取得（tcpdump）を足したもの。
# ros2lab:jazzy をベースにするため、先に `docker compose build ros2lab-a` でイメージを作っておくこと。
FROM ros2lab:jazzy

# tcpdump: 平文露出と認証ハンドシェイクの確認
RUN apt-get update \
    && apt-get install -y --no-install-recommends tcpdump \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
