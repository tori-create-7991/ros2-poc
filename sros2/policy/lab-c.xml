<?xml version="1.0"?>
<!--
  環境 C（適正設定）の permissions 元。最小権限: コンテナごとに必要なトピックだけを許可する。
  ワイルドカードなし。permissions の default は sros2 が DENY で生成する。
  トピック名は先頭の / を付けない（sros2 の書式）。
  ros2lab-a: ロボット側（状態を出し、指令を受ける）/ ros2lab-b: 操作側（指令を出し、状態を受ける）
  ros2arm / ros2server: 下の注記のとおり、稼働中のグラフと拒否ログから生成した
-->
<policy version="0.2.0" xmlns:xi="http://www.w3.org/2001/XInclude">
  <enclaves>
    <enclave path="/lab/ros2lab_a">
      <profiles>
        <profile ns="/" node="lab_robot">
          <topics publish="ALLOW">
            <topic>lab/state</topic>
            <topic>parameter_events</topic>
          </topics>
          <topics subscribe="ALLOW">
            <topic>lab/cmd</topic>
            <topic>parameter_events</topic>
          </topics>
        </profile>
      </profiles>
    </enclave>
    <enclave path="/lab/ros2lab_b">
      <profiles>
        <profile ns="/" node="lab_operator">
          <topics publish="ALLOW">
            <topic>lab/cmd</topic>
            <topic>parameter_events</topic>
          </topics>
          <topics subscribe="ALLOW">
            <topic>lab/state</topic>
            <topic>parameter_events</topic>
          </topics>
        </profile>
      </profiles>
    </enclave>
    <!--
      ros2arm（シミュ）と ros2server（VLA ノード・変換ノード）: 1 コンテナ 1 enclave（ROS_SECURITY_ENCLAVE_OVERRIDE）で、
      多数のノードが共有するので、permissions はノードの和集合になる。稼働中のグラフ（ros2 security generate_policy）と、
      そのポリシーで動かしたときの拒否ログから、scripts/sros2/lib/sim_policy.py で生成した（再生成の手順はそのファイルの先頭）。
      - トピック・サービス・アクションは実在する名前を列挙している（ワイルドカードなし）。
      - 例外: 起動のたびに名前が変わるノード（moveit_<数字>、transform_listener_impl_<ハッシュ>、ros2 CLI の _ros2cli_<数字>）の
        標準のパラメータ・ログ系サービスだけ */<サービス名> のパターンにしている（ノード名ごとの列挙は次の起動で外れる）。
      - 足りないエンドポイントは拒否され、そのノードが落ちる。見つかったら拒否ログを sim_policy.py の denials オプションに渡して生成し直す。
    -->
